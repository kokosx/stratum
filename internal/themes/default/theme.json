{
  "schemaVersion": 1,
  "id": "stratum/default",
  "version": 1,
  "name": "Stratum Default",
  "description": "A flexible, accessible first-party theme built around semantic design tokens.",
  "menuLocations": [
    {
      "id": "primary",
      "label": "Primary Navigation"
    },
    {
      "id": "topbar",
      "label": "Top Bar"
    },
    {
      "id": "footer",
      "label": "Footer Navigation"
    },
    {
      "id": "legal",
      "label": "Footer Legal"
    }
  ],
  "groups": [
    {
      "id": "colors",
      "label": "Colors",
      "description": "Semantic colors shared by the theme and blocks."
    },
    {
      "id": "typography",
      "label": "Typography"
    },
    {
      "id": "spacing",
      "label": "Spacing Scale"
    },
    {
      "id": "shape",
      "label": "Radius, Border & Shadow"
    },
    {
      "id": "layout",
      "label": "Layout"
    },
    {
      "id": "header",
      "label": "Header"
    },
    {
      "id": "navigation",
      "label": "Navigation"
    },
    {
      "id": "topbar",
      "label": "Top Bar"
    },
    {
      "id": "footer",
      "label": "Footer"
    },
    {
      "id": "buttons",
      "label": "Buttons"
    },
    {
      "id": "links",
      "label": "Links"
    },
    {
      "id": "advanced",
      "label": "Advanced"
    }
  ],
  "settings": {
    "appearance.mode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light",
      "ui": {
        "label": "Appearance",
        "description": "Presets update the palette; this value marks the selected appearance.",
        "group": "colors",
        "control": "segmented"
      }
    },
    "colors.background": {
      "type": "color",
      "default": "#ffffff",
