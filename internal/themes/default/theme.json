    "typography.fontBody": {
      "type": "string",
      "enum": [
        "systemSans",
        "modernSans",
        "humanistSans",
        "systemSerif",
        "editorialSerif",
        "monospace"
      ],
      "default": "systemSans",
      "ui": {
        "label": "Body font",
        "group": "typography",
        "control": "font"
      },
      "output": {
        "cssVariable": "--st-font-body",
        "values": {
          "systemSans": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "modernSans": "Inter, ui-sans-serif, system-ui, sans-serif",
          "humanistSans": "Optima, Candara, 'Noto Sans', sans-serif",
          "systemSerif": "ui-serif, Georgia, Cambria, 'Times New Roman', serif",
          "editorialSerif": "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, serif",
          "monospace": "ui-monospace, 'SFMono-Regular', Consolas, monospace"
        }
      }
    },
    "typography.fontHeading": {
      "type": "string",
      "enum": [
        "systemSans",
        "modernSans",
        "humanistSans",
        "systemSerif",
        "editorialSerif",
        "monospace"
      ],
      "default": "systemSans",
      "ui": {
        "label": "Heading font",
        "group": "typography",
        "control": "font"
      },
      "output": {
        "cssVariable": "--st-font-heading",
        "values": {
          "systemSans": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "modernSans": "Inter, ui-sans-serif, system-ui, sans-serif",
          "humanistSans": "Optima, Candara, 'Noto Sans', sans-serif",
          "systemSerif": "ui-serif, Georgia, Cambria, 'Times New Roman', serif",
          "editorialSerif": "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, serif",
          "monospace": "ui-monospace, 'SFMono-Regular', Consolas, monospace"
        }
      }
